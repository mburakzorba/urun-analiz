# Backend'i çalıştırıp gerçek AI analizini aktif etmek istersen bu dosyayı
# .env olarak kopyala ve backend adresini yaz (bkz. server/README.md).
#
# Not: EXPO_PUBLIC_ ile başlayan değişkenler uygulamaya (client) gömülür,
# bu yüzden buraya API anahtarı gibi gizli bilgi KOYMA — anahtar sadece
# server/.env dosyasında, backend tarafında kalmalı.
#
# Örnek (yerel ağda, telefon ve bilgisayar aynı Wi-Fi'de iken):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
#
# Örnek (backend'i Render/Railway gibi bir yere deploy ettiysen):
# EXPO_PUBLIC_API_URL=https://urun-analiz-api.onrender.com

EXPO_PUBLIC_API_URL=

# Backend'deki APP_SHARED_SECRET ile AYNI değer olmalı (server/.env dosyasına
# bak). Bu, rastgele birinin backend adresini bulup doğrudan istek atmasını
# zorlaştıran basit bir korumadır — gizli bir "parola" gibi düşün. Kendi
# başına rastgele, uzun bir metin üret (örn. bir şifre üreticiyle) ve HEM
# buraya HEM server/.env'deki APP_SHARED_SECRET'a aynısını yaz.
EXPO_PUBLIC_APP_SECRET=

# 16 Eylül eklemesi: gerçek hesap sistemi (e-posta/şifre + Google ile giriş)
# Supabase üzerinden çalışıyor. Ücretsiz bir Supabase projesi oluşturup
# (supabase.com) Project Settings > API sayfasından "Project URL" ve
# "anon public" anahtarını buraya yapıştır. Bu ikisi GİZLİ DEĞİLDİR — client
# uygulamaya gömülmeleri normaldir (Supabase'in "Row Level Security" ile
# korunur). Hesap SİLME için ayrıca kullanılan "service_role" anahtarı ise
# ASLA buraya veya uygulamaya konulmaz — sadece server/.env dosyasında durur.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google ile giriş için Google Cloud Console'da oluşturduğun "Web application"
# tipi OAuth istemcisinin Client ID'si (Android istemcisi değil!) — Supabase
# Google sağlayıcısına da aynısını gireceksin. Detaylı adımlar teslimat
# mesajında.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
