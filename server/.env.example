# Anthropic Console'dan (console.anthropic.com/settings/keys) alacağın API anahtarı
ANTHROPIC_API_KEY=

# İsteğe bağlı: kullanılacak model (varsayılan: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Sunucunun çalışacağı port
PORT=3000

# /analyze endpoint'ini rastgele/dışarıdan erişimden korumak için basit bir
# paylaşılan gizli anahtar. Client'taki (.env dosyasındaki) EXPO_PUBLIC_APP_SECRET
# ile BİREBİR AYNI değer olmalı. Kendi rastgele, uzun bir metin üret (örn.
# https://www.uuidgenerator.net/ ile bir UUID üretip kullanabilirsin).
APP_SHARED_SECRET=

# --- 9 Eylül eklemesi: "Sorun bildir" ekranının otomatik e-posta göndermesi ---
# resend.com'da ÜCRETSİZ bir hesap açıp bir API anahtarı üret, buraya yapıştır.
RESEND_API_KEY=

# Bildirimlerin GERÇEKTE gideceği kendi e-posta adresin (örn. seninkisi).
REPORT_EMAIL_TO=

# İsteğe bağlı: göndereni özelleştirmek istersen (kendi alan adını resend.com'da
# doğrulaman gerekir). Boş bırakırsan Resend'in doğrulama gerektirmeyen test
# göndereni ("onboarding@resend.dev") kullanılır — bildirim yine ulaşır.
REPORT_EMAIL_FROM=

# --- 16 Eylül eklemesi: gerçek hesap sistemi (hesap SİLME) ---
# Aynı Supabase projesinin URL'i — client tarafındaki (root .env)
# EXPO_PUBLIC_SUPABASE_URL ile AYNI değer. Supabase Dashboard > Project
# Settings > API sayfasından "Project URL".
SUPABASE_URL=

# ÖNEMLİ: bu, client'taki "anon public" anahtarla AYNI ŞEY DEĞİL — bu
# "service_role" (gizli) anahtarı, Supabase Dashboard > Project Settings >
# API sayfasında "service_role" satırında (varsayılan gizli, "Reveal"e bas).
# Bu anahtar projenin TÜM verisine sınırsız erişim verir — ASLA client'a
# (.env / EXPO_PUBLIC_...) veya başka bir yere KOPYALAMA, sadece burada,
# sadece Render'ın Environment ayarlarında dursun.
SUPABASE_SERVICE_ROLE_KEY=
