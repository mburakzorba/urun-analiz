{
  "expo": {
    "name": "özünde",
    "slug": "urun-analiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ürün etiketini/içeriğini analiz etmek için kameraya erişim gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galerinden ürün fotoğrafı seçebilmek için erişim gerekiyor.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.burakzorba3737.urunanaliz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B2622D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.burakzorba3737.urunanaliz"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ürün etiketini/içeriğini analiz etmek için kameraya erişim gerekiyor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerinden ürün fotoğrafı seçebilmek için erişim gerekiyor."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Paylaşım kartını galerine kaydedebilmek için fotoğraf erişimi gerekiyor.",
          "savePhotosPermission": "Oluşturduğun paylaşım kartını galerine kaydedebilmek için izin gerekiyor.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "045ddb38-3935-43a1-b604-ba37afc95ac4"
      }
    }
  }
}
